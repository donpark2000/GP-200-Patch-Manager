# Generated at build time by .github/workflows/ci.yml's "Stamp build
# version from git" step, right before PyInstaller freezes the script --
# see get_version()'s docstring in gp200.py. Never meant to be committed:
# it's a snapshot of "whatever commit is being built right now," which is
# already what git itself records for every other file.
_build_version.py

# Python
__pycache__/
*.pyc
*.pyo

# PyInstaller build artifacts (planned -- see README Roadmap)
build/
dist/
*.spec

# Run-time artifacts gp200.py can generate -- never meant to be committed
gp200_*.log
failed_verify_*.prst
diag_backup*.prst
gp200_*.zip
*_test*.prst

# Editors / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
